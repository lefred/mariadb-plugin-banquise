COMPATIBLE	varchar(3)	NO		NULL	
SELECT COUNT(*) FROM INFORMATION_SCHEMA.BANQUISE_CATALOG;
COUNT(*)
0
SHOW STATUS LIKE 'banquise_message';
Variable_name	Value
Banquise_message	Ready; automatic catalog refresh is disabled
SHOW VARIABLES LIKE 'banquise_%';
Variable_name	Value
banquise_auto_refresh	OFF
banquise_connect_timeout	10
banquise_refresh	OFF
banquise_transfer_timeout	120
SELECT PLUGIN_NAME, PLUGIN_TYPE
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'banquise_%' AND PLUGIN_TYPE = 'FUNCTION'
  ORDER BY PLUGIN_NAME;
PLUGIN_NAME	PLUGIN_TYPE
banquise_install	FUNCTION
banquise_uninstall	FUNCTION
banquise_update	FUNCTION
SELECT banquise_install('vmstat');
ERROR HY000: BANQUISE: No compatible catalog entry named 'vmstat'
SHOW STATUS LIKE 'banquise_message';
Variable_name	Value
Banquise_message	Install failed: No compatible catalog entry named 'vmstat'
SELECT banquise_update('vmstat');
ERROR HY000: BANQUISE: No compatible catalog entry named 'vmstat'
SELECT banquise_uninstall('vmstat');
ERROR HY000: BANQUISE: No compatible catalog entry named 'vmstat'
SELECT banquise_install('vmstat', 'community');
ERROR HY000: BANQUISE: No compatible catalog entry named 'vmstat'
SELECT banquise_install('vmstat', NULL);
ERROR HY000: BANQUISE: Invalid or NULL repository name
SELECT banquise_install('vmstat', '');
ERROR HY000: BANQUISE: Invalid or NULL repository name
